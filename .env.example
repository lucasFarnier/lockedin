# Use a fresh Supabase project or local Supabase stack.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with VITE_ or commit populated values.
SUPABASE_SERVICE_ROLE_KEY=

# Optional profile lookup. Mock returns fictional data and makes no vendor calls.
PROFILE_PROVIDER=mock
# PDL_API_KEY=

# Optional CV parsing, common-ground analysis and outreach drafts.
# LOVABLE_API_KEY=

# Optional LinkedIn sign-in. Use the canonical HTTPS origin without a trailing slash.
# LINKEDIN_SIGN_IN_ORIGIN=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Optional direct PostgreSQL connection for Drizzle Kit.
# LOVABLE_DB_MIGRATION_URL=
